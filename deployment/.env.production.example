# Copy to deployment/.env.production on the server. Never commit the copy.
NODE_ENV=production
PORT=7006
FRONTEND_URL=https://replace-with-your-domain.example

POSTGRES_DB=dhisoft_rural_skill
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://replace-me:replace-me@postgres:5432/dhisoft_rural_skill?schema=public
DIRECT_URL=postgresql://replace-me:replace-me@postgres:5432/dhisoft_rural_skill?schema=public

JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-random-secret
PASSWORD_RESET_SECRET=replace-with-a-random-secret
ENCRYPTION_KEY=replace-with-a-32-byte-key
CSRF_SECRET=replace-with-a-random-secret

STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=replace-me-private-bucket
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
QUEUE_PROVIDER=sqs
EVENTBUS_PROVIDER=eventbridge
EVENTBUS_NAME=rural-events
STREAM_PROVIDER=kafka
KAFKA_BROKERS=replace-with-private-broker:9092
CACHE_PROVIDER=redis
REDIS_URL=redis://redis:6379
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50

# The browser talks to nginx; this is only needed if the frontend build uses
# a separate public backend URL.
NEXT_PUBLIC_API_URL=https://replace-with-your-domain.example/api
