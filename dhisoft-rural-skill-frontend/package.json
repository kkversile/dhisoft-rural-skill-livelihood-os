{
  "name": "dhisoft-rural-skill-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7000",
    "build": "next build",
    "start": "next start -p 7000",
    "lint": "eslint src --max-warnings=0",
