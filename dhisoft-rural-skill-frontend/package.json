    "next-intl": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.61.1",
    "recharts": "^3.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.5",
